DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=repository_skripsi_ftUnira
# Wajib. Di production minimal 32 karakter dan tidak boleh nilai contoh.
JWT_SECRET=your_jwt_secret
# Opsional. Default: 1d.
JWT_EXPIRES_IN=1d

# Opsional. Default: <root backend>/uploads.
# Gunakan path absolut untuk production, misalnya /var/www/repository/uploads.
UPLOAD_DIR=

# Opsional. Kosongkan untuk memakai default aman.
# Login: 10 percobaan / 15 menit (production), 50 (development).
LOGIN_RATE_LIMIT_WINDOW_MS=
LOGIN_RATE_LIMIT_MAX=
# Register: 5 akun / jam (production), 20 (development).
REGISTER_RATE_LIMIT_WINDOW_MS=
REGISTER_RATE_LIMIT_MAX=
# API umum: 600 request / 15 menit (production), 3000 (development).
API_RATE_LIMIT_WINDOW_MS=
API_RATE_LIMIT_MAX=
# Upload PDF: 20 unggahan / jam (production), 100 (development).
UPLOAD_RATE_LIMIT_WINDOW_MS=
UPLOAD_RATE_LIMIT_MAX=

# Opsional. Set true/jumlah hop jika berjalan di belakang reverse proxy.
TRUST_PROXY=false
