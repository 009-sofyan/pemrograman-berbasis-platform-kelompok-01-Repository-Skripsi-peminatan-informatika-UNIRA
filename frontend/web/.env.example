# API backend Express (melalui proxy Vite saat development)
VITE_API_BASE_URL=/api

# Target proxy Vite (dipakai vite.config.ts, bukan oleh browser)
VITE_API_PROXY_TARGET=http://localhost:3000

# Opsional: origin backend untuk file upload bila tidak memakai proxy.
# Kosongkan bila VITE_API_BASE_URL relatif.
# VITE_API_ORIGIN=http://localhost:3000
